{
  "mode": "enforce",
  "node": "vm-k3s-node8",
  "prometheus_url": "http://prometheus-ha-query.observability.svc:9090",
  "clean_seconds": 900,
  "evict_per_run": 2,
  "soft_cap": 4,
  "soft_recover": {
    "op": "<", "threshold": 0.75,
    "query": "max_over_time((1 - avg(rate(node_cpu_seconds_total{nodename=\"vm-k3s-node8\",mode=~\"idle|iowait|steal\"}[2m])))[10m:30s])"
  },
  "signals": {
    "node_cpu_busy_4m": {
      "tier": "soft", "op": ">", "threshold": 0.85,
      "query": "min_over_time((1 - avg(rate(node_cpu_seconds_total{nodename=\"vm-k3s-node8\",mode=~\"idle|iowait|steal\"}[2m])))[4m:30s])"
    },
    "node_memory_used_2m": {
      "tier": "hard", "op": ">", "threshold": 0.85,
      "query": "min_over_time((1 - node_memory_MemAvailable_bytes{nodename=\"vm-k3s-node8\"} / node_memory_MemTotal_bytes{nodename=\"vm-k3s-node8\"})[2m:30s])"
    },
    "frigate_skipped_ratio_4m": {
      "tier": "hard", "op": ">", "threshold": 0.03,
      "query": "min_over_time((sum(frigate_skipped_fps{job=\"frigate\"}) / clamp_min(sum(frigate_camera_fps{job=\"frigate\"}), 1))[4m:30s])"
    },
    "frigate_decode_deficit_4m": {
      "tier": "hard", "op": ">", "threshold": 0.06,
      "query": "min_over_time(((sum(frigate_camera_fps{job=\"frigate\"}) - sum(frigate_process_fps{job=\"frigate\"})) / clamp_min(sum(frigate_camera_fps{job=\"frigate\"}), 1))[4m:30s])"
    },
    "frigate_started_age_seconds": {
      "tier": "hard", "op": "<", "threshold": 300,
      "query": "time() - max(kube_pod_container_state_started{namespace=\"frigate\",container=\"frigate\"})"
    }
  },
  "reserve": {
    "nodes": ["vm-k3s-node4", "vm-k3s-node5", "vm-k3s-node6", "vm-k3s-node7"],
    "cap": 16,
    "trip": {
      "op": ">", "threshold": 0.92,
      "query": "min_over_time((sum(rate(node_cpu_seconds_total{nodename=\"$NODE\",mode!~\"idle|iowait|steal\"}[2m])) / max(kube_node_status_allocatable{node=\"$NODE\",resource=\"cpu\"}))[2m:30s])"
    },
    "recover": {
      "op": "<", "threshold": 0.85,
      "query": "max_over_time((sum(rate(node_cpu_seconds_total{nodename=\"$NODE\",mode!~\"idle|iowait|steal\"}[2m])) / max(kube_node_status_allocatable{node=\"$NODE\",resource=\"cpu\"}))[10m:30s])"
    }
  }
}
