{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "estate-ci#110 pilot: the estate version detector proposes updates; it never merges. Only the pinned pip tools in scripts/self-test.sh for now; more managers join batch by batch.",
  "extends": [],
  "dependencyDashboard": false,
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "pip pins installed by scripts/self-test.sh",
      "managerFilePatterns": ["/^scripts/self-test\\.sh$/"],
      "matchStrings": ["(?<depName>[A-Za-z0-9][A-Za-z0-9_.-]*)==(?<currentValue>[0-9][A-Za-z0-9_.+-]*)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "branchPrefix": "renovate/",
  "commitMessagePrefix": "deps:"
}
